{
  "name": "@luau2ts/analyzer",
  "version": "0.1.0",
  "description": "Luau type checker (Luau.Analysis compiled to WebAssembly). Optional companion to luau2ts that surfaces input-side type errors before translation.",
  "type": "module",
  "license": "MIT",
  "author": "Tony Bolivar",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-wasm.mjs",
    "build:wasm": "bash build/build.sh",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "luau",
    "type-checker",
    "luau-analyze",
    "wasm",
    "roblox"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luau2ts/luau2ts.git",
    "directory": "packages/analyzer"
  },
  "homepage": "https://luau2ts.com",
  "bugs": {
    "url": "https://github.com/luau2ts/luau2ts/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
